{
  "buildCommand": "node ./scripts/vite-shim.js",
  "outputDirectory": "www",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*\\.html|admin.*|worker.*|customer.*|pitch.*|^/$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/worker",
      "destination": "/index.html"
    },
    {
      "source": "/worker/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/customer",
      "destination": "/index.html"
    },
    {
      "source": "/customer/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/pitch",
      "destination": "/index.html"
    },
    {
      "source": "/pitch/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
