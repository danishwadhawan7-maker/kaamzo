{
  "buildCommand": "node ./scripts/vite-shim.js",
  "outputDirectory": "www",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.html|admin.*|worker.*|customer.*|register.*|jobs.*|pitch.*|^/$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/register/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/jobs",
      "destination": "/index.html"
    },
    {
      "source": "/jobs/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/worker",
      "destination": "/index.html"
    },
    {
      "source": "/worker/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/customer",
      "destination": "/index.html"
    },
    {
      "source": "/customer/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/pitch",
      "destination": "/index.html"
    },
    {
      "source": "/pitch/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/__/auth/(.*)",
      "destination": "https://nifty-backup-mc9s2.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/(.*)",
      "destination": "https://nifty-backup-mc9s2.firebaseapp.com/__/firebase/$1"
    },
    {
      "source": "/((?!api/|assets/|__auth/|__/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "kaamzo.site"
        }
      ],
      "destination": "https://www.kaamzo.site/$1",
      "permanent": true
    }
  ]
}