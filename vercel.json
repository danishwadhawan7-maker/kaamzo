{
  "buildCommand": "node ./scripts/vite-shim.js",
  "outputDirectory": "www",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/worker",
      "destination": "/index.html"
    },
    {
      "source": "/customer",
      "destination": "/index.html"
    },
    {
      "source": "/pitch",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
