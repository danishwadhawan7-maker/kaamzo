# Copy to .env (NEVER commit .env). All admin secrets live ONLY on the server.
NODE_ENV=production
PORT=3000

# Comma-separated admin emails allowed to sign in (never shipped to the browser)
ADMIN_EMAILS=you@example.com

# Generate with:  node scripts/hash-secret.js   (use a long, unique password)
ADMIN_PASSWORD_HASH=
# 6+ digit PIN hash, generate the same way
ADMIN_PIN_HASH=
# Generate with:  node scripts/hash-secret.js --random   (>= 32 chars)
SESSION_SECRET=

# Firebase web API key (public) - used to verify Google SSO ID tokens server-side
FIREBASE_WEB_API_KEY=

# Admin 2FA email delivery (required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kaamzo Security <no-reply@kaamzo.site>"

# Extra browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://www.kaamzo.site,https://kaamzo.site
# Set to 1 only when behind a trusted reverse proxy / Cloud Run / Render
TRUST_PROXY=1
