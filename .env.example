# =============================================================================
# Kaamzo Production Environment Template (.env.example)
# Copy to .env (NEVER commit .env or firebase-service-account.json to Git)
# Run `node scripts/generate-keys.js` to automatically generate 256-bit keys.
# =============================================================================

NODE_ENV=production
PORT=3000

# 1. MongoDB Atlas Connection (M0 Free Tier or Paid Cluster - TLS enabled)
# Upgrade cluster tier anytime by changing only MONGODB_URI here; zero code changes required.
MONGODB_USERNAME=your_atlas_db_username
MONGODB_PASSWORD=your_atlas_db_password
MONGODB_URI=mongodb+srv://your_atlas_db_username:your_atlas_db_password@cluster0.example.mongodb.net/kaamzo?retryWrites=true&w=majority&tls=true

# 2. 256-Bit Field-Level Encryption Keys (Generated via `node scripts/generate-keys.js`)
# AES-256-GCM key (32 bytes = 64 hex characters). Back up safely!
ENCRYPTION_KEY=
# HMAC-SHA256 blind-index key for searchable encrypted phone/email/Aadhaar lookups (64 hex chars)
ENCRYPTION_HMAC_KEY=

# 3. Firebase Authentication (Google Login stays 100% on Firebase Auth)
FIREBASE_PROJECT_ID=nifty-backup-mc9s2
FIREBASE_WEB_API_KEY=
# Optional path to Firebase Admin SDK Service Account JSON file OR inline JSON string
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# Legacy Firestore Database ID (used only by the one-time migration script)
FIRESTORE_DATABASE_ID=ai-studio-remixdihadi2-48a2ad23-40fd-4483-b22e-afff081bb36d

# 4. Admin Portal Security (Server-Side Only)
ADMIN_EMAILS=bhavnoorsinghkochar@gmail.com,danishwadhawan7@gmail.com
ADMIN_PASSWORD_HASH=
ADMIN_PIN_HASH=
SESSION_SECRET=

# 5. CORS & Proxy Security
ALLOWED_ORIGINS=https://kaamzo.site,https://www.kaamzo.site,http://localhost:3000,http://localhost:5173
TRUST_PROXY=1

# 6. Optional OTP Delivery (SMTP / Twilio / AiSensy / Interakt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kaamzo Security <no-reply@kaamzo.site>"
